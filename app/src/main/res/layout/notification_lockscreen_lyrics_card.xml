<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lockscreen_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/lockscreen_card_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_oneui_lockscreen_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="15dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- One UI Header Row: Brand Pill + Track / Artist Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_oneui_lockscreen_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_airlyrics_note"
                    android:tint="#96B8FF" />

                <TextView
                    android:id="@+id/tv_card_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="AirLyrics"
                    android:textColor="#DCE6FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_track_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#A6B1C6"
                android:textSize="12sp"
                tools:text="Exchange • Bryson Tiller" />
        </LinearLayout>

        <!-- Previous / Context Lyric Line -->
        <TextView
            android:id="@+id/tv_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="1"
            android:textColor="#5CFFFFFF"
            android:textSize="13.5sp"
            tools:text="Waiting in a car" />

        <!-- Active / Current Lyric Line -->
        <TextView
            android:id="@+id/tv_lyric_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.16"
            android:maxLines="3"
            android:textColor="#FFFFFFFF"
            android:textSize="19.5sp"
            android:textStyle="bold"
            tools:text="Waiting for a ride in the dark" />

        <!-- Next / Upcoming Lyric Line -->
        <TextView
            android:id="@+id/tv_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="2"
            android:textColor="#8AFFFFFF"
            android:textSize="14sp"
            tools:text="The night city grows" />

        <!-- Subtle One UI Playback Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_oneui_lockscreen"
            android:visibility="gone"
            tools:progress="42"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>