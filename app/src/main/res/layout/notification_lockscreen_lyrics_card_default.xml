<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lockscreen_default_surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_oneui_lockscreen_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="11dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_oneui_lockscreen_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_airlyrics_note"
                android:tint="#96B8FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="AirLyrics"
                android:textColor="#DCE6FF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_default_track_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#A6B1C6"
            android:textSize="11.5sp"
            tools:text="3am in Oakland • Karri" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_default_lyric_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.12"
        android:maxLines="2"
        android:textColor="#FFFFFFFF"
        android:textSize="16.5sp"
        android:textStyle="bold"
        tools:text="Waiting for a ride in the dark" />

    <TextView
        android:id="@+id/tv_default_lyric_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.08"
        android:maxLines="1"
        android:textColor="#8AFFFFFF"
        android:textSize="12.5sp"
        tools:text="The night city grows" />

    <ProgressBar
        android:id="@+id/pb_default_card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_oneui_lockscreen"
        android:visibility="gone"
        tools:progress="42"
        tools:visibility="visible" />
</LinearLayout>
