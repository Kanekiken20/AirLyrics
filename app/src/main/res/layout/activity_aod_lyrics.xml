<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aodRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <!-- Burn-in pixel-shifted container -->
    <LinearLayout
        android:id="@+id/aodContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="88dp">

        <!-- One UI Styled Top Clock (Time + Date) -->
        <LinearLayout
            android:id="@+id/aodClockContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/aodClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="#F2FFFFFF"
                android:textSize="62sp"
                tools:text="14:35" />

            <TextClock
                android:id="@+id/aodDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, MMM d"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="#B8DCE4F2"
                android:textSize="15sp"
                tools:text="Wed, Nov 25" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Centered One UI 3-Line Squircle Card -->
        <LinearLayout
            android:id="@+id/aodLyricsSquircleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_oneui_widget_card_aod"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="22dp">

            <TextView
                android:id="@+id/aodTrackInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="#B0C4DEFF"
                android:textSize="12.5sp"
                tools:text="♪ Exchange • Bryson Tiller" />

            <TextView
                android:id="@+id/aodPreviousLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:textColor="#6EFFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Waiting in a car" />

            <TextView
                android:id="@+id/aodCurrentLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18"
                android:maxLines="3"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Waiting for a ride in the dark" />

            <TextView
                android:id="@+id/aodNextLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:textColor="#9CFFFFFF"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="The night city grows" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.2" />
    </LinearLayout>

    <!-- Bottom hint left clear of in-display fingerprint zone -->
    <TextView
        android:id="@+id/aodDismissHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="Double-tap to dismiss"
        android:textColor="#4CFFFFFF"
        android:textSize="12sp" />

</FrameLayout>
