<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aod_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/aod_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_aod_track_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:textColor="#7AFFFFFF"
            android:textSize="11sp"
            tools:text="Midnight City • M83" />

        <TextView
            android:id="@+id/tv_aod_lyric_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="3"
            android:textColor="#F0FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Waiting for a ride in the dark" />

        <TextView
            android:id="@+id/tv_aod_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="1"
            android:textColor="#6EFFFFFF"
            android:textSize="12.5sp"
            tools:text="The night city grows" />
    </LinearLayout>
</FrameLayout>